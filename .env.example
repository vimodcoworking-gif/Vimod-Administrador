# Copia este archivo como .env y coloca tus valores.
# Debe ser la MISMA base de datos que usa VIMOD PRESENTACION.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/vimod?retryWrites=true&w=majority

# Acceso al panel
ADMIN_USUARIO=admin
ADMIN_PASSWORD=una-contraseña-segura

# Texto largo y aleatorio para firmar la sesión del administrador
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# URL pública de VIMOD PRESENTACION (para enviar el enlace de acceso a los clientes)
SITIO_URL=https://vimod-sistemas.onrender.com

PORT=4000
